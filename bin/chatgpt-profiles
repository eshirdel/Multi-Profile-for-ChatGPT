#!/bin/bash
# Multi Profile for ChatGPT - isolated ChatGPT desktop profiles on macOS.
# Copyright 2026 Ebrahim Shirdel. Licensed under the Apache License, Version 2.0.
#
# Compatible with the bash 3.2 that ships with macOS.

set -euo pipefail

REPO="eshirdel/Multi-Profile-for-ChatGPT"

APP="${CHATGPT_APP:-/Applications/ChatGPT.app}"
PREFIX="${MPFC_PREFIX:-$HOME/.local/share/multi-profile-for-chatgpt}"
LAUNCHER_DIR="${MPFC_LAUNCHER_DIR:-$HOME/Applications}"
PROFILE_APPS_DIR="${MPFC_PROFILE_APPS_DIR:-$LAUNCHER_DIR/ChatGPT Profiles}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/multi-profile-for-chatgpt"
PROFILES_DIR="$CONFIG_DIR/profiles"
ICONS_DIR="$CONFIG_DIR/icons"
PREVIEWS_DIR="$CONFIG_DIR/previews"
APP_SUPPORT="$HOME/Library/Application Support"
DEFAULT_ROOT_BASE="$APP_SUPPORT/Multi Profile for ChatGPT/Profiles"
MANAGER_APP="$LAUNCHER_DIR/ChatGPT Profiles.app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

PALETTE_NAMES="green slate orange purple red teal pink amber"
PRESET_NAMES="personal company friend client third-party sandbox"

palette_hex() {
  case "$1" in
    green) echo "#16A34A" ;; slate) echo "#1F2937" ;; orange) echo "#EA580C" ;; purple) echo "#9333EA" ;;
    red) echo "#DC2626" ;; teal) echo "#0D9488" ;; pink) echo "#DB2777" ;; amber) echo "#D97706" ;;
    *) return 1 ;;
  esac
}

preset_color() {
  case "$1" in
    company) echo "slate" ;;
    work) echo "teal" ;;
    personal) echo "purple" ;;
    friend) echo "amber" ;;
    client) echo "green" ;;
    third-party) echo "orange" ;;
    sandbox) echo "purple" ;;
    *) echo "pink" ;;
  esac
}

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
ROOT="$(cd -P "$(dirname "$self")/.." && pwd)"
BADGE_JS="$ROOT/lib/badge-icon.js"
MANAGER_JS="$ROOT/lib/profile-manager.js"
VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION" 2>/dev/null || echo dev)"

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

usage() {
  cat <<EOF
Multi Profile for ChatGPT $VERSION (unofficial, not affiliated with OpenAI)

Usage:
  chatgpt-profiles
  chatgpt-profiles manager
      Open the native profile manager. This is the default.

  chatgpt-profiles create --name NAME [options]
      Create exactly one isolated profile.

Options:
  --preset NAME       $PRESET_NAMES
  --root DIR          dedicated profile root; contains codex/ and electron/
  --icon FILE         optional custom overlay image
  --label TEXT        optional 1-3 character text badge instead of a logo overlay
  --color COLOR       $PALETTE_NAMES or #RRGGBB
  --open              open the profile after creating it

Other commands:
  chatgpt-profiles list
  chatgpt-profiles open NAME
  chatgpt-profiles rebuild [NAME]
  chatgpt-profiles remove NAME [--purge]
  chatgpt-profiles manager-install
  chatgpt-profiles update [--check]
  chatgpt-profiles version

Original is never duplicated or migrated. The manager opens the existing
/Applications/ChatGPT.app for Original, preserving its current login and history.
EOF
}

require_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "this tool only runs on macOS"
  [ -d "$APP" ] || die "ChatGPT app not found at $APP (install it from OpenAI, or set CHATGPT_APP)"
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr ' _' '--' | tr -cd 'a-z0-9-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'
}

valid_name() {
  case "$1" in
    ''|*[!A-Za-z0-9\ _-]*) return 1 ;;
  esac
  [ -n "$(slugify "$1")" ]
}

valid_preset() {
  case " $PRESET_NAMES " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

resolve_color() {
  local c="$1"
  if palette_hex "$c" >/dev/null 2>&1; then palette_hex "$c"; return; fi
  case "$c" in
    \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f])
      echo "$c" | tr '[:lower:]' '[:upper:]'
      ;;
    *) return 1 ;;
  esac
}

normalize_root() {
  local p="$1"
  case "$p" in
    *$'\n'*|*$'\r'*) die "--root cannot contain newlines" ;;
  esac
  case "$p" in
    "~") p="$HOME" ;;
    \~/*) p="$HOME/${p#~/}" ;;
  esac
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  while [ "$p" != "/" ] && [ "${p%/}" != "$p" ]; do p="${p%/}"; done
  printf '%s\n' "$p"
}

profile_conf() { echo "$PROFILES_DIR/$1.conf"; }
profile_app_dir() { echo "$PROFILE_APPS_DIR/$1"; }
launcher_path_for_slug() { echo "$(profile_app_dir "$1")/ChatGPT $2.app"; }
launcher_path() {
  local slug
  slug="$(slugify "$1")"
  launcher_path_for_slug "$slug" "$1"
}
profile_manifest() { echo "$(profile_app_dir "$1")/profile.json"; }
default_profile_root() { echo "$DEFAULT_ROOT_BASE/$1"; }
legacy_codex_home() { echo "$HOME/.codex-$1"; }
legacy_user_data_dir() { echo "$APP_SUPPORT/ChatGPT-$2"; }

load_profile() {
  local f
  f="$(profile_conf "$1")"
  [ -f "$f" ] || die "no profile named '$1' (see: chatgpt-profiles list)"
  NAME="$(sed -n 's/^NAME=//p' "$f")"
  LABEL="$(sed -n 's/^LABEL=//p' "$f")"
  COLOR="$(sed -n 's/^COLOR=//p' "$f")"
  PRESET="$(sed -n 's/^PRESET=//p' "$f")"
  PROFILE_ROOT="$(sed -n 's/^ROOT=//p' "$f")"
  ICON="$(sed -n 's/^ICON=//p' "$f")"
  [ -n "$PRESET" ] || PRESET="badge"
  [ -n "$COLOR" ] || COLOR="#16A34A"
}

codex_home_loaded() {
  local slug="$1"
  if [ -n "$PROFILE_ROOT" ]; then echo "$PROFILE_ROOT/codex"; else legacy_codex_home "$slug"; fi
}

user_data_loaded() {
  local slug="$1"
  if [ -n "$PROFILE_ROOT" ]; then echo "$PROFILE_ROOT/electron"; else legacy_user_data_dir "$slug" "$NAME"; fi
}

save_profile() {
  local slug="$1" name="$2" preset="$3" root="$4" icon="$5" label="$6" color="$7"
  mkdir -p "$PROFILES_DIR"
  umask 077
  {
    printf 'NAME=%s\n' "$name"
    printf 'PRESET=%s\n' "$preset"
    printf 'ROOT=%s\n' "$root"
    printf 'ICON=%s\n' "$icon"
    printf 'LABEL=%s\n' "$label"
    printf 'COLOR=%s\n' "$color"
  } > "$(profile_conf "$slug")"
}

root_in_use_by_other_profile() {
  local wanted="$1" except_slug="$2" f slug existing
  for f in "$PROFILES_DIR"/*.conf; do
    [ -f "$f" ] || continue
    slug="$(basename "$f" .conf)"
    [ "$slug" = "$except_slug" ] && continue
    existing="$(sed -n 's/^ROOT=//p' "$f")"
    [ -n "$existing" ] && [ "$existing" = "$wanted" ] && return 0
  done
  return 1
}

store_custom_icon() {
  local slug="$1" src="$2" ext dest
  [ -n "$src" ] || { printf '%s\n' ""; return; }
  [ -f "$src" ] || die "icon file not found: $src"
  case "$src" in
    *.icns|*.png|*.jpg|*.jpeg|*.tiff) ;;
    *) die "--icon must be .icns, .png, .jpg, .jpeg or .tiff" ;;
  esac
  ext="${src##*.}"
  mkdir -p "$ICONS_DIR"
  dest="$ICONS_DIR/$slug-custom.$ext"
  cp "$src" "$dest"
  chmod 600 "$dest"
  printf '%s\n' "$dest"
}

app_icon() {
  local icon
  icon="$(defaults read "$APP/Contents/Info.plist" CFBundleIconFile 2>/dev/null || true)"
  [ -n "$icon" ] || icon="app"
  case "$icon" in *.icns) ;; *) icon="$icon.icns" ;; esac
  [ -f "$APP/Contents/Resources/$icon" ] || die "cannot find the ChatGPT icon in $APP"
  echo "$APP/Contents/Resources/$icon"
}

bundled_codex() {
  local codex="$APP/Contents/Resources/codex-cli/bin/codex"
  [ -x "$codex" ] || die "bundled Codex executable not found: $codex"
  printf '%s\n' "$codex"
}

build_profile_runtime() {
  local slug="$1" home="$2" data="$3" runtime wrapper launch real_codex
  runtime="$PROFILE_ROOT/runtime"
  wrapper="$runtime/codex-wrapper.sh"
  launch="$runtime/launch-profile.sh"
  real_codex="$(bundled_codex)"

  mkdir -p "$runtime"
  chmod 700 "$runtime"

  {
    printf '%s\n' '#!/bin/bash'
    printf 'expected_home=%q\n' "$home"
    printf 'expected_data=%q\n' "$data"
    printf 'expected_cli=%q\n' "$wrapper"
    printf 'real_codex=%q\n' "$real_codex"
    cat <<'EOF'
set -euo pipefail

canonical_dir() {
  if [ -d "$1" ]; then
    (CDPATH= cd -P -- "$1" && pwd -P)
  else
    printf '%s\n' "$1"
  fi
}

actual_home="${CODEX_HOME:-}"
[ -n "$actual_home" ] || {
  printf 'profile isolation: CODEX_HOME is unset\n' >&2
  exit 64
}
[ "$(canonical_dir "$actual_home")" = "$(canonical_dir "$expected_home")" ] || {
  printf 'profile isolation: refusing CODEX_HOME=%s; expected %s\n' "$actual_home" "$expected_home" >&2
  exit 64
}
[ "${CODEX_ELECTRON_USER_DATA_PATH:-}" = "$expected_data" ] || {
  printf 'profile isolation: refusing CODEX_ELECTRON_USER_DATA_PATH=%s; expected %s\n' "${CODEX_ELECTRON_USER_DATA_PATH:-<unset>}" "$expected_data" >&2
  exit 64
}
[ "${CODEX_CLI_PATH:-}" = "$expected_cli" ] || {
  printf 'profile isolation: refusing CODEX_CLI_PATH=%s; expected %s\n' "${CODEX_CLI_PATH:-<unset>}" "$expected_cli" >&2
  exit 64
}
[ -x "$real_codex" ] || {
  printf 'profile isolation: bundled Codex is missing: %s\n' "$real_codex" >&2
  exit 69
}

codex_bin="$(dirname "$real_codex")"
case ":${PATH:-}:" in
  *":$codex_bin:"*) ;;
  *) PATH="$codex_bin${PATH:+:$PATH}" ;;
esac
export PATH

exec "$real_codex" -c "shell_environment_policy.set.PATH=$PATH" "$@"
EOF
  } > "$wrapper"

  {
    printf '%s\n' '#!/bin/bash'
    printf 'expected_home=%q\n' "$home"
    printf 'expected_data=%q\n' "$data"
    printf 'expected_cli=%q\n' "$wrapper"
    printf 'profile_title=%q\n' "ChatGPT $NAME"
    printf 'app=%q\n' "$APP"
    cat <<'EOF'
set -euo pipefail

refuse_mismatch() {
  key="$1"
  current="$2"
  expected="$3"
  if [ -n "$current" ] && [ "$current" != "$expected" ]; then
    printf 'profile isolation: refusing %s=%s; expected %s\n' "$key" "$current" "$expected" >&2
    exit 64
  fi
}

refuse_mismatch CODEX_HOME "${CODEX_HOME:-}" "$expected_home"
refuse_mismatch CODEX_ELECTRON_USER_DATA_PATH "${CODEX_ELECTRON_USER_DATA_PATH:-}" "$expected_data"
refuse_mismatch CODEX_CLI_PATH "${CODEX_CLI_PATH:-}" "$expected_cli"

mkdir -p "$expected_home" "$expected_data"
chmod 700 "$expected_home" "$expected_data"

export CODEX_HOME="$expected_home"
export CODEX_ELECTRON_USER_DATA_PATH="$expected_data"
export CODEX_CLI_PATH="$expected_cli"
export CODEX_APP_TITLE="$profile_title"

exec /usr/bin/open -n \
  --env CODEX_HOME="$CODEX_HOME" \
  --env CODEX_ELECTRON_USER_DATA_PATH="$CODEX_ELECTRON_USER_DATA_PATH" \
  --env CODEX_CLI_PATH="$CODEX_CLI_PATH" \
  --env CODEX_APP_TITLE="$CODEX_APP_TITLE" \
  "$app" --args "--user-data-dir=$expected_data"
EOF
  } > "$launch"

  chmod 700 "$wrapper" "$launch"
  printf '%s\n' "$launch"
}
json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

write_profile_manifest() {
  local slug="$1" launcher="$2" home="$3" data="$4" dir
  dir="$(profile_app_dir "$slug")"
  mkdir -p "$dir"
  umask 077
  cat > "$(profile_manifest "$slug")" <<EOF
{
  "name": "$(json_escape "$NAME")",
  "slug": "$(json_escape "$slug")",
  "preset": "$(json_escape "$PRESET")",
  "appPath": "$(json_escape "$launcher")",
  "root": "$(json_escape "$PROFILE_ROOT")",
  "codexHome": "$(json_escape "$home")",
  "electronUserData": "$(json_escape "$data")",
  "bundleIdentifier": "io.github.eshirdel.mpfc.$slug"
}
EOF
  chmod 600 "$(profile_manifest "$slug")"
}

build_profile_launcher() {
  local slug="$1"
  local launcher home data tmp out mode launch_script
  load_profile "$slug"

  launcher="$(launcher_path "$NAME")"
  home="$(codex_home_loaded "$slug")"
  data="$(user_data_loaded "$slug")"
  tmp="$(mktemp -d)"

  mkdir -p "$home" "$data" "$(profile_app_dir "$slug")"
  chmod 700 "$home" "$data" "$(profile_app_dir "$slug")"

  if [ -n "$PROFILE_ROOT" ]; then
    launch_script="$(build_profile_runtime "$slug" "$home" "$data")"
    cat > "$tmp/launch.applescript" <<EOF
do shell script quoted form of "$launch_script"
EOF
  else
    # v0.1 compatibility: preserve legacy data paths exactly and do not migrate.
    cat > "$tmp/launch.applescript" <<EOF
set codexHome to "$home"
set userData to "$data"
do shell script "/bin/mkdir -p " & quoted form of codexHome & " " & quoted form of userData & " && /usr/bin/open -n --env CODEX_HOME=" & quoted form of codexHome & " --env CODEX_ELECTRON_USER_DATA_PATH=" & quoted form of userData & " " & quoted form of "$APP" & " --args " & quoted form of ("--user-data-dir=" & userData)
EOF
  fi

  out="$(osacompile -o "$tmp/ChatGPT $NAME.app" "$tmp/launch.applescript" 2>&1)" || {
    rm -rf "$tmp"; die "osacompile failed: $out";
  }

  mode="$PRESET"
  [ -n "$LABEL" ] && mode="badge"
  local icon_arg label_arg
  icon_arg="$ICON"; [ -n "$icon_arg" ] || icon_arg="__MPFC_EMPTY__"
  label_arg="$LABEL"; [ -n "$label_arg" ] || label_arg="__MPFC_EMPTY__"
  out="$(osascript -l JavaScript "$BADGE_JS" "$(app_icon)" "$mode" "$icon_arg" "$label_arg" "$COLOR" "$tmp/icon.iconset" 2>&1)" || {
    rm -rf "$tmp"; die "icon render failed: $out";
  }
  iconutil -c icns "$tmp/icon.iconset" -o "$tmp/ChatGPT $NAME.app/Contents/Resources/applet.icns"

  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier io.github.eshirdel.mpfc.$slug" "$tmp/ChatGPT $NAME.app/Contents/Info.plist" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string io.github.eshirdel.mpfc.$slug" "$tmp/ChatGPT $NAME.app/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c "Set :CFBundleName ChatGPT $NAME" "$tmp/ChatGPT $NAME.app/Contents/Info.plist" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Add :CFBundleName string ChatGPT $NAME" "$tmp/ChatGPT $NAME.app/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c "Set :CFBundleDisplayName ChatGPT $NAME" "$tmp/ChatGPT $NAME.app/Contents/Info.plist" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Add :CFBundleDisplayName string ChatGPT $NAME" "$tmp/ChatGPT $NAME.app/Contents/Info.plist"
  codesign --force --sign - "$tmp/ChatGPT $NAME.app" >/dev/null 2>&1

  # Preserve any previous generated launcher as a timestamped backup.
  if [ -e "$launcher" ]; then
    mv "$launcher" "$(profile_app_dir "$slug")/ChatGPT $NAME.previous-$(date +%Y%m%d-%H%M%S).app"
  fi
  mv "$tmp/ChatGPT $NAME.app" "$launcher"
  write_profile_manifest "$slug" "$launcher" "$home" "$data"
  touch "$launcher"
  [ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$launcher" >/dev/null 2>&1 || true
  rm -rf "$tmp"
}

cmd_create() {
  local name="" preset="personal" root="" icon="" label="" color="" hex="" open_after=0
  local slug existing_root stored_icon default_color

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="${2:-}"; shift 2 ;;
      --preset) preset="${2:-}"; shift 2 ;;
      --root) root="${2:-}"; shift 2 ;;
      --icon) icon="${2:-}"; shift 2 ;;
      --label) label="${2:-}"; shift 2 ;;
      --color) color="${2:-}"; shift 2 ;;
      --open) open_after=1; shift ;;
      --yes|-y) shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  valid_name "$name" || die "--name is required (letters, numbers, spaces, - or _)"
  valid_preset "$preset" || die "unknown --preset '$preset' (choose: $PRESET_NAMES)"
  [ ${#label} -le 3 ] || die "--label must be at most 3 characters"

  slug="$(slugify "$name")"
  [ "$slug" != "original" ] || die "'Original' is reserved for your existing ChatGPT profile"

  [ -n "$root" ] || root="$(default_profile_root "$slug")"
  root="$(normalize_root "$root")"

  if [ -f "$(profile_conf "$slug")" ]; then
    load_profile "$slug"
    existing_root="$PROFILE_ROOT"
    if [ -z "$existing_root" ]; then
      die "profile '$name' uses legacy paths; rebuild it without changing its data root"
    fi
    [ "$existing_root" = "$root" ] || die "profile '$name' already exists with root '$existing_root'; refusing to move or migrate its data"
  fi

  root_in_use_by_other_profile "$root" "$slug" && die "data root is already used by another profile: $root"

  if [ -n "$color" ]; then
    hex="$(resolve_color "$color")" || die "unknown color: $color"
  else
    default_color="$(preset_color "$preset")"
    hex="$(resolve_color "$default_color")"
  fi

  if [ -n "$icon" ]; then
    stored_icon="$(store_custom_icon "$slug" "$icon")"
  elif [ -f "$(profile_conf "$slug")" ]; then
    load_profile "$slug"
    stored_icon="$ICON"
  else
    stored_icon=""
  fi

  save_profile "$slug" "$name" "$preset" "$root" "$stored_icon" "$label" "$hex"
  build_profile_launcher "$slug"
  info "Created $name"
  info "  launcher : $(launcher_path "$name")"
  info "  root     : $root"
  info "  codex    : $root/codex"
  info "  app data : $root/electron"

  if [ "$open_after" = 1 ]; then
    open "$(launcher_path "$name")"
  fi
  return 0
}

cmd_list() {
  local f slug found=0
  printf '%s\n' "Original"
  printf '  launcher : %s\n' "$APP"
  printf '  data     : existing ChatGPT profile (untouched)\n'

  for f in "$PROFILES_DIR"/*.conf; do
    [ -f "$f" ] || continue
    found=1
    slug="$(basename "$f" .conf)"
    load_profile "$slug"
    printf '%s  (%s)\n' "$NAME" "$PRESET"
    printf '  launcher : %s%s\n' "$(launcher_path "$NAME")" "$([ -d "$(launcher_path "$NAME")" ] || echo '  [missing, run rebuild]')"
    if [ -n "$PROFILE_ROOT" ]; then
      printf '  root     : %s\n' "$PROFILE_ROOT"
      printf '  codex    : %s/codex\n' "$PROFILE_ROOT"
      printf '  app data : %s/electron\n' "$PROFILE_ROOT"
    else
      printf '  codex    : %s\n' "$(legacy_codex_home "$slug")"
      printf '  app data : %s\n' "$(legacy_user_data_dir "$slug" "$NAME")"
      printf '  note     : legacy profile paths\n'
    fi
  done
  [ "$found" = 1 ] || info "No isolated profiles yet."
}

find_slug() {
  local slug
  slug="$(slugify "${1:-}")"
  [ -n "$slug" ] || die "profile name required"
  [ -f "$(profile_conf "$slug")" ] || die "no profile named '$1' (see: chatgpt-profiles list)"
  echo "$slug"
}

cmd_open() {
  local slug
  case "${1:-}" in
    Original|original) open "$APP"; return ;;
  esac
  slug="$(find_slug "${1:-}")"
  load_profile "$slug"
  [ -d "$(launcher_path "$NAME")" ] || build_profile_launcher "$slug"
  open "$(launcher_path "$NAME")"
}

cmd_rebuild() {
  local f slug
  if [ -n "${1:-}" ]; then
    slug="$(find_slug "$1")"
    build_profile_launcher "$slug"
    load_profile "$slug"
    info "Rebuilt $NAME"
    return
  fi
  for f in "$PROFILES_DIR"/*.conf; do
    [ -f "$f" ] || continue
    slug="$(basename "$f" .conf)"
    build_profile_launcher "$slug"
    load_profile "$slug"
    info "Rebuilt $NAME"
  done
}

ask_line() {
  local prompt="$1"
  printf '%s' "$prompt" >&2
  IFS= read -r REPLY || REPLY=""
}

cmd_remove() {
  local slug purge=0 name_arg="" answer stamp home data
  while [ $# -gt 0 ]; do
    case "$1" in --purge) purge=1 ;; *) name_arg="$1" ;; esac
    shift
  done

  slug="$(find_slug "$name_arg")"
  load_profile "$slug"
  rm -rf "$(launcher_path "$NAME")"
  rm -f "$(profile_conf "$slug")"
  info "Removed launcher/config for $NAME."

  [ "$purge" = 1 ] || {
    info "Profile data was kept."
    return
  }

  home="$(codex_home_loaded "$slug")"
  data="$(user_data_loaded "$slug")"
  info "This will move only this isolated profile's data to the Trash:"
  info "  $home"
  info "  $data"
  ask_line "Type the profile name to confirm: "
  answer="$REPLY"
  [ "$answer" = "$NAME" ] || { info "Not confirmed; data kept."; return; }

  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$HOME/.Trash"
  [ -e "$home" ] && mv "$home" "$HOME/.Trash/mpfc-$slug-codex-$stamp"
  [ -e "$data" ] && mv "$data" "$HOME/.Trash/mpfc-$slug-electron-$stamp"
  info "Moved isolated profile data to the Trash."
}

build_preset_previews() {
  local preset color_name hex tmp out icns_tmp png_src
  mkdir -p "$PREVIEWS_DIR"
  chmod 700 "$PREVIEWS_DIR"

  for preset in $PRESET_NAMES; do
    color_name="$(preset_color "$preset")"
    hex="$(resolve_color "$color_name")"
    tmp="$(mktemp -d)"

    out="$(osascript -l JavaScript "$BADGE_JS" "$(app_icon)" "$preset" "__MPFC_EMPTY__" "__MPFC_EMPTY__" "$hex" "$tmp/icon.iconset" 2>&1)" || {
      rm -rf "$tmp"
      die "preset preview render failed for $preset: $out"
    }

    icns_tmp="$PREVIEWS_DIR/$preset.tmp.icns"
    iconutil -c icns "$tmp/icon.iconset" -o "$icns_tmp"
    mv "$icns_tmp" "$PREVIEWS_DIR/$preset.icns"

    png_src="$tmp/icon.iconset/icon_128x128@2x.png"
    if [ -f "$png_src" ]; then
      cp "$png_src" "$PREVIEWS_DIR/$preset.png.tmp"
      mv "$PREVIEWS_DIR/$preset.png.tmp" "$PREVIEWS_DIR/$preset.png"
    fi

    rm -rf "$tmp"
  done
}

build_manager_launcher() {
  local tmp out cli
  tmp="$(mktemp -d)"
  cli="${MPFC_RUNTIME_BIN:-$self}"
  mkdir -p "$LAUNCHER_DIR"
  build_preset_previews

  cat > "$tmp/manager.applescript" <<EOF
do shell script quoted form of "$cli" & " manager-ui"
EOF

  out="$(osacompile -o "$tmp/ChatGPT Profiles.app" "$tmp/manager.applescript" 2>&1)" || {
    rm -rf "$tmp"; die "manager launcher compile failed: $out";
  }

  out="$(osascript -l JavaScript "$BADGE_JS" "$(app_icon)" manager "__MPFC_EMPTY__" "__MPFC_EMPTY__" "#1F2937" "$tmp/icon.iconset" 2>&1)" || {
    rm -rf "$tmp"; die "manager icon render failed: $out";
  }
  iconutil -c icns "$tmp/icon.iconset" -o "$tmp/ChatGPT Profiles.app/Contents/Resources/applet.icns"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier io.github.eshirdel.mpfc.manager" "$tmp/ChatGPT Profiles.app/Contents/Info.plist" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string io.github.eshirdel.mpfc.manager" "$tmp/ChatGPT Profiles.app/Contents/Info.plist"
  codesign --force --sign - "$tmp/ChatGPT Profiles.app" >/dev/null 2>&1

  if [ -e "$MANAGER_APP" ]; then
    mv "$MANAGER_APP" "$tmp/old-manager.app"
  fi
  mv "$tmp/ChatGPT Profiles.app" "$MANAGER_APP"
  [ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$MANAGER_APP" >/dev/null 2>&1 || true
  rm -rf "$tmp"
  info "Manager installed: $MANAGER_APP"
}

cmd_manager_ui() {
  [ -f "$MANAGER_JS" ] || die "profile manager UI missing: $MANAGER_JS"
  export MPFC_CLI="$self"
  exec osascript -l JavaScript "$MANAGER_JS"
}

cmd_manager() {
  [ -d "$MANAGER_APP" ] || build_manager_launcher >/dev/null
  open "$MANAGER_APP"
}

version_gt() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n1)" = "$1" ]
}

latest_version() {
  curl -fsSIL -o /dev/null -w '%{url_effective}' "https://github.com/$REPO/releases/latest" | sed -n 's#.*/tag/v\{0,1\}##p'
}

cmd_update() {
  local latest tmp base expected actual
  latest="$(latest_version)" || true
  [ -n "$latest" ] || die "no published release found for $REPO (or GitHub is unreachable)"
  if ! version_gt "$latest" "$VERSION"; then
    info "chatgpt-profiles $VERSION is up to date."
    return
  fi

  info "Update available: $VERSION -> $latest"
  [ "${1:-}" != "--check" ] || return

  tmp="$(mktemp -d)"
  base="https://github.com/$REPO/releases/download/v$latest"
  curl -fsSL "$base/multi-profile-for-chatgpt.tar.gz" -o "$tmp/r.tar.gz" || die "download failed"
  curl -fsSL "$base/multi-profile-for-chatgpt.tar.gz.sha256" -o "$tmp/r.sha256" || die "checksum download failed"
  expected="$(awk '{print $1}' "$tmp/r.sha256")"
  actual="$(shasum -a 256 "$tmp/r.tar.gz" | awk '{print $1}')"
  [ -n "$expected" ] && [ "$expected" = "$actual" ] || die "checksum mismatch, update aborted"

  mkdir -p "$tmp/x"
  tar -xzf "$tmp/r.tar.gz" -C "$tmp/x"
  bash "$tmp/x/multi-profile-for-chatgpt/install.sh" --local "$tmp/x/multi-profile-for-chatgpt"
  rm -rf "$tmp"

  "$PREFIX/current/bin/chatgpt-profiles" rebuild 2>/dev/null || true
  MPFC_RUNTIME_BIN="$PREFIX/current/bin/chatgpt-profiles" \
    "$PREFIX/current/bin/chatgpt-profiles" manager-install 2>/dev/null || true
}

main() {
  local cmd="${1:-manager}"
  [ $# -eq 0 ] || shift

  case "$cmd" in
    -h|--help|help) usage; return ;;
    version|--version|-v) echo "chatgpt-profiles $VERSION"; return ;;
  esac

  require_macos

  case "$cmd" in
    manager) cmd_manager ;;
    manager-ui) cmd_manager_ui ;;
    manager-install) build_manager_launcher ;;
    create) cmd_create "$@" ;;
    list) cmd_list ;;
    open) cmd_open "$@" ;;
    rebuild) cmd_rebuild "$@" ;;
    remove) cmd_remove "$@" ;;
    update) cmd_update "$@" ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"